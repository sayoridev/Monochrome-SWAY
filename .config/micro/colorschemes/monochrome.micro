color-link default "ffffff,000000"
color-link comment "aaaaaa,italic"
color-link identifier "ffffff,bold"
color-link constant "cccccc"
color-link constant.string "dddddd"
color-link statement "ffffff,bold"
color-link symbol "888888"
color-link preproc "888888"
color-link type "ffffff,bold"
color-link special "dddddd"
color-link ignore "666666"
color-link error "000000,ffffff"
color-link todo "000000,ffffff"

color-link line-number "555555,000000"
color-link current-line-number "ffffff,000000"
color-link cursor-line "111111"
color-link selection "000000,88aaff"

color-link statusline "000000,ffffff"
color-link tabbar "ffffff,000000"
color-link indent-char "222222"
color-link scrollbar "333333"
color-link divider "222222"
