configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 12";
    bg: #000000;
    fg: #ffffff;
    accent: #ffffff;
    gray: #333333;
    
    background-color: @bg;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    text-color: @fg;
    border: 1px;
    border-color: @accent;
    width: 320px;
    location: center;
    anchor: center;
    x-offset: 0;
    y-offset: 0;
}

mainbox {
    background-color: @bg;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 15px;
}

inputbar {
    background-color: @bg;
    text-color: @fg;
    expand: false;
    border: 0px 0px 1px 0px;
    border-color: @gray;
    margin: 0px;
    padding: 0px 0px 8px 0px;
    children: [ prompt ];
}

prompt {
    background-color: @bg;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    background-color: @bg;
    columns: 1;
    lines: 5;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 8px 12px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    expand: true;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}

element selected {
    background-color: #ffffff;
    text-color: #000000;
}

element-text selected {
    background-color: #ffffff;
    text-color: #000000;
    font: "JetBrainsMono Nerd Font Bold 12";
}
